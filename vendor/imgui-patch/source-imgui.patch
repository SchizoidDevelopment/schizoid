+// Java-owned glyph ranges outlive ConfigData, even after atlas builds.
+#include <mutex>
+#include <cstdlib>
+struct JavaRangeNode { ImFontAtlas* atlas; ImWchar* ranges; JavaRangeNode* next; };
+static std::mutex java_range_mutex;
+static JavaRangeNode* java_range_head = NULL;
+bool JavaTrackFontRanges(ImFontAtlas* atlas, ImWchar* ranges) noexcept
+{
+    JavaRangeNode* node = (JavaRangeNode*)std::malloc(sizeof(JavaRangeNode));
+    if (!node) return false;
+    try {
+        std::lock_guard<std::mutex> lock(java_range_mutex);
+        node->atlas = atlas; node->ranges = ranges; node->next = java_range_head;
+        java_range_head = node;
+        return true;
+    } catch (...) { std::free(node); return false; }
+}
+void JavaUntrackFontRanges(ImFontAtlas* atlas, ImWchar* ranges) noexcept
+{
+    try {
+        std::lock_guard<std::mutex> lock(java_range_mutex);
+        JavaRangeNode** p = &java_range_head;
+        while (*p) {
+            JavaRangeNode* node = *p;
+            if (node->atlas == atlas && node->ranges == ranges) {
+                *p = node->next; IM_FREE(node->ranges); std::free(node); return;
+            }
+            p = &node->next;
+        }
+    } catch (...) { /* Retain ownership if locking fails. */ }
+}
+static void JavaClearFontRanges(ImFontAtlas* atlas) noexcept
+{
+    try {
+        std::lock_guard<std::mutex> lock(java_range_mutex);
+        JavaRangeNode** p = &java_range_head;
+        while (*p) {
+            JavaRangeNode* node = *p;
+            if (node->atlas == atlas) {
+                *p = node->next; IM_FREE(node->ranges); std::free(node);
+            } else p = &node->next;
+        }
+    } catch (...) { /* Preserve live ranges on lock failure. */ }
+}
